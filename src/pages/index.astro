---
import MainLayout from "../layouts/MainLayout.astro";
---

<MainLayout>
  <div class="hero">
    <img src="/pfp.png" class="hero-img" />
    <div class="hero-info">
      <h1>Hello there!</h1>
      <p>I'm Cris(or Crislzy bc im lazy af). I'm a teen developer from Romania and a <a href="https://hackclub.com/">Hack Club</a> member.</p>
      <p>I love coding random stuff like websites and Slack/Discord bots. I also like selfhosting stuff.</p>
      <h2>Tech Stacks</h2>
      <img src="https://skillicons.dev/icons?i=html,css,astro,ts,js,py,bun,nodejs,sqlite,git,github,linux,docker&theme=light" alt="Tech stack" class="skill-icons">
    </div>
  </div>

  <div class="section">
    <h2>Projects</h2>
    <p>Here are some of my projects:</p>
    <div class="projects">
      <div class="project">
        <h3>🌱 (PTG)Please Touch Grass</h3>
        <p>Please Touch Grass is a joke website where you touch grass and it updates a global counter.</p>
        <p><a href="https://pleasetouchgrass.fyi">View Website</a> | <a href="https://github.com/crislazy/ptg">View on GitHub</a></p>
      </div>
      <div class="project">
        <h3>🐱 MeowRing</h3>
        <p>The webring for cat lovers(mostly abandoned but still accepting new members and contributions).</p>
        <p><a href="https://webring.crislzy.xyz/">View Website</a> | <a href="https://github.com/crislazy/webring">View on GitHub</a></p>
      </div>
      <div class="project">
        <h3>😺 Whiskers</h3>
        <p>A simple Slack selfbot that welcomes and DMs new channel members, has autoreplies and more.</p>
        <p><a href="https://github.com/crislazy/whiskers">View on GitHub</a></p>
      </div>
    </div>
  </div>
</MainLayout>
